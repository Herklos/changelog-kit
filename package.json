{
  "name": "changelog-kit",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Drakkar-Software/changelog-kit.git" },
  "private": true,
  "version": "0.1.0",
  "description": "Generate branded product changelog visuals in multiple templates, resolutions and targets (png, jpg, webp, pdf, svg, html).",
  "type": "module",
  "scripts": {
    "example": "pnpm --filter @changelog-kit/examples run generate",
    "cli": "pnpm --filter @changelog-kit/cli exec changelog-kit",
    "lint": "eslint packages",
    "test": "node --test \"packages/*/test/*.test.js\""
  },
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "devDependencies": {
    "eslint": "^9.12.0"
  }
}
