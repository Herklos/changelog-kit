{
  "name": "@changelog-kit/templates",
  "version": "0.2.0",
  "type": "module",
  "description": "Layout templates for changelog visuals — every template is a pure (ctx) => ReactElement function, renderable natively (React Native) or through SSR (react-native-web).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drakkar-Software/changelog-kit.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/Drakkar-Software/changelog-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./layouts/*": {
      "types": "./dist/src/layouts/*.d.ts",
      "default": "./dist/src/layouts/*.js"
    },
    "./rn": {
      "react-native": {
        "types": "./dist/src/rn.native.d.ts",
        "default": "./dist/src/rn.native.js"
      },
      "default": {
        "types": "./dist/src/rn.web.d.ts",
        "default": "./dist/src/rn.web.js"
      }
    },
    "./svg": {
      "react-native": {
        "types": "./dist/src/svg.native.d.ts",
        "default": "./dist/src/svg.native.js"
      },
      "default": {
        "types": "./dist/src/svg.web.d.ts",
        "default": "./dist/src/svg.web.js"
      }
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "dependencies": {
    "@changelog-kit/brand": "workspace:*",
    "@changelog-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "*",
    "react-native-svg": "^15.0.0",
    "react-native-web": "^0.19.0 || ^0.20.0 || ^0.21.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0.19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.81.4",
    "react-native-svg": "15.13.0",
    "react-native-web": "^0.21.2"
  }
}
