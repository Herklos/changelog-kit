{
  "name": "@changelog-kit/ai-images",
  "version": "0.1.0",
  "type": "module",
  "description": "Provider-agnostic AI image generation: one interface, adapters for OpenAI, Stability, Replicate, Google and a deterministic mock.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drakkar-Software/changelog-kit.git",
    "directory": "packages/ai-images"
  },
  "homepage": "https://github.com/Drakkar-Software/changelog-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./providers/*": {
      "types": "./dist/src/providers/*.d.ts",
      "default": "./dist/src/providers/*.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "devDependencies": {
    "@changelog-kit/brand": "workspace:*"
  }
}
